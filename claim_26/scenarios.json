        "source_uri": "https://policy-store.internal/policies/active"
      },
      "action_record": {
        "action_id": "act-004",
        "authority_event_id": "auth-004",
        "action_type": "read:credentials:dev",
        "run_id": "run-004",
        "snapshot_hash": null,
        "written_at": "2026-06-06T12:00:02Z"
      },
      "audit_context": {
        "active_snapshot_hash": "sha256:policy_v21_sequence_42"
      }
    },
    {
      "id": 5,
      "label": "hash_mismatch",
      "description": "Authority and action snapshot hashes disagree — the action was authorized against different evidence than what the authority record shows.",
      "expected": "REFUSED_SNAPSHOT_MISMATCH",
