        "source_sequence": 42,
        "policy_version": "v2.1",
        "run_id": "run-006",
        "is_immutable": false,
        "written_at": "2026-06-06T12:00:01Z",
        "source_uri": null
      },
      "action_record": {
        "action_id": "act-006",
        "authority_event_id": "auth-006",
        "action_type": "read:credentials:dev",
        "run_id": "run-006",
        "snapshot_hash": "sha256:policy_v21_sequence_42",
