        "run_id": "run-007",
        "is_immutable": true,
        "written_at": "2026-06-06T12:00:01Z",
        "source_uri": null
      },
      "action_record": {
        "action_id": "act-007",
        "authority_event_id": "auth-007",
        "action_type": "read:credentials:dev",
        "run_id": "run-007",
        "snapshot_hash": "sha256:policy_v20_sequence_38",
        "written_at": "2026-06-06T12:00:02Z"
