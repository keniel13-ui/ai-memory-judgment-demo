        "run_id": "run-005",
        "snapshot_hash": "sha256:policy_v20_sequence_38",
        "written_at": "2026-06-06T12:00:02Z"
      },
      "audit_context": {
        "active_snapshot_hash": "sha256:policy_v21_sequence_42"
      }
    },
    {
      "id": 6,
      "label": "tampered",
      "description": "Authority record is mutable — is_immutable=false. Evidence may have been altered after the action was taken.",
      "expected": "REFUSED_TAMPERED",
      "authority_record": {
        "authority_event_id": "auth-006",
        "grant_id": "grant-abc",
        "decision": "ALLOW",
        "decision_timestamp": "2026-06-06T12:00:00Z",
